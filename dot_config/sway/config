# variables
set $mod Mod4

set $left h
set $down j
set $up k
set $right l

set $browser librewolf
set $terminal foot
set $utility discord
set $game steam
set $launcher tofi-run | xargs swaymsg exec --
set $screenshot grim -g "$(slurp)" - | swappy -f -

# output configuration
output DP-1 resolution 1920x1080 position 1920 0

# input configuration
input type:pointer {
    pointer_accel -0.8
}

input type:touchpad {
    dwt                 enabled
    tap                 enabled
    natural_scroll      enabled
    middle_emulation    enabled
}

input type:keyboard {
    repeat_delay 200
    repeat_rate 60
}

# key bindings
bindsym $mod+t exec $terminal
bindsym $mod+b exec $browser
bindsym $mod+u exec $utility
bindsym $mod+g exec $game
bindsym $mod+Space exec $launcher
bindsym Print exec $screenshot

bindsym $mod+q kill
bindsym $mod+Shift+c reload

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4

assign [app_id="foot"] workspace number 1
assign [app_id="librewolf"] workspace number 2
assign [app_id="discord"] workspace number 3
assign [class="steam"] workspace number 4

mode "resize" {
    bindsym $left resize shrink width 10px
	bindsym $down resize grow height 10px
	bindsym $up resize shrink height 10px
	bindsym $right resize grow width 10px

	bindsym Left resize shrink width 10px
	bindsym Down resize grow height 10px
	bindsym Up resize shrink height 10px
	bindsym Right resize grow width 10px

	bindsym Return mode "default"
	bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

bindsym XF86AudioMute          exec wpctl set-mute     @DEFAULT_SINK@ toggle
bindsym XF86AudioLowerVolume   exec wpctl set-volume   @DEFAULT_SINK@ 5%-
bindsym XF86AudioRaiseVolume   exec wpctl set-volume --limit 1.5 @DEFAULT_SINK@ 5%+

bindsym XF86MonBrightnessDown  exec brightnessctl set 25%-
bindsym XF86MonBrightnessUp    exec brightnessctl set 25%+

# theming
bar {
    swaybar_command waybar
}

set $background #000000

client.focused $background $background $background $background
client.unfocused $background $background $background $background

default_border pixel

seat seat0 xcursor_theme Hackneyed

# misc
exec mako
include /etc/sway/config.d/* 
